# Robotku deploy — environment variables for scripts/deploy.sh
#
# Copy to `.env.deploy` and fill in real values. NEVER commit .env.deploy.
# Only this example file is tracked.
#
# Usage:
#   source .env.deploy && bash scripts/deploy.sh
#   — or —
#   env $(cat .env.deploy | xargs) bash scripts/deploy.sh

# ── FTP credentials (WAJIB — deploy gagal kalau belum diset) ──
FTP_HOST=ftp.example.com
FTP_USER=u123456789
FTP_PASS=ganti_dengan_password_asli

# ── Optional ──

# Remote directory on the FTP server (default: /public_html)
# FTP_REMOTE_DIR=/public_html

# Skip 3D assets (~20 MB) — recommended for first deploy
SKIP_SIM3D=1

# Force full upload on pass 1 (no --only-newer). Use on first deploy
# or when shared-host clock drift causes files to be skipped.
FORCE_FULL=1

# Write HTTPS redirect to .htaccess. ONLY set to 1 AFTER confirming:
#   curl -sSI https://hub.robotku.id | head -1
# returns HTTP/2 without TLS errors. Otherwise it locks the site.
# ENABLE_HTTPS_REDIRECT=1

# Write HSTS header. ONLY after HTTPS redirect is confirmed safe in prod.
# A wrong HSTS header locks browsers out for max-age and can't be undone.
# ENABLE_HSTS=1
