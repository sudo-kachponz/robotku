# Robotku — example environment file.
#
# Copy to `.env.local` for local development. NEVER commit real secrets — only
# `.env.example` is tracked (see .gitignore).
#
# The app itself is a static export (output: 'export') and currently reads NO
# runtime environment variables — everything ships in the bundle. This file is a
# placeholder so new NEXT_PUBLIC_* config has an obvious, documented home.
#
# Example (uncomment + set if/when the app starts reading it):
# NEXT_PUBLIC_SITE_URL=https://hub.robotku.id

# --- Build / CI only (not read by the browser) ---
# GITHUB_SHA is injected by GitHub Actions and stamped into out/version.json by
# scripts/postbuild.mjs. Locally it falls back to `git rev-parse --short HEAD`.
# GITHUB_SHA=

# Deploy (FTPS) credentials live ONLY in GitHub Secrets, never here:
#   FTP_HOST / FTP_USER / FTP_PASS
#
# Set ENABLE_HSTS=1 in the deploy environment ONLY after HTTPS is verified in
# production — a wrong HSTS header locks the site out and can't be undone fast.
# ENABLE_HSTS=
